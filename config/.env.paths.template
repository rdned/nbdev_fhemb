# Human-readable node name (your machine)
NODENAME="My Machine"

# Local project root
# macOS/Linux default: ~/Projects/fhemb/
# Windows default:     %USERPROFILE%\Projects\fhemb\
LOCALROOT="~/Projects/fhemb/"

# NAS mount point
# macOS default:  /Volumes/NASstorage/
# Linux default:  /mnt/NASstorage/
# Windows default: Z:\
MOUNT="/Volumes/NASstorage/"

# Thermal data directory on the NAS
# macOS default:  /Volumes/NASstorage/thermal_data/
# Linux default:  /mnt/NASstorage/thermal_data/
# Windows default: Z:\thermal_data\
AUDIOFILES="/Volumes/NASstorage/thermal_data/"
