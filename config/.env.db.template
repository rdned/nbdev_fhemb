# ---- SSH configuration ----

# Passphrase for your SSH private key (leave empty if unencrypted)
SSH_PASSPHRASE=

# Remote server hosting PostgreSQL/TimescaleDB
REMOTE_HOST=
REMOTE_PORT=22

# SSH login
SSH_USERNAME=
# macOS/Linux: ~/.ssh/id_rsa
# Windows:     %USERPROFILE%\.ssh\id_rsa
SSH_PKEY="~/.ssh/id_rsa"

# ---- Local bind address for SSH tunnel ----
REMOTE_BIND_HOST=localhost
REMOTE_BIND_PORT=5432

# ---- Database parameters ----
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
